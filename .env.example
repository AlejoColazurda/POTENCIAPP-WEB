# Copiá este archivo a .env.local para desarrollo. Ver docs/admin-setup.md.
GEMINI_API_KEY=
# URL opcional: si falta, se deduce de la anon key. También se aceptan SUPABASE_PUBLIC_KEY y SUPABASE_SERVICE_ROLE.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dueños del panel (siempre tienen acceso). Editores se invitan desde /admin/equipo.
ADMIN_EMAILS=
CRON_SECRET=
# Opcional: habilita POST /api/blog/publish (crea borradores, no publica). Mínimo 24 caracteres.
AGENT_API_SECRET=
